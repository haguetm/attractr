# Copy to .env (never committed). Local values are printed by `npx supabase status`.

# development | production. "tester en tant que" and mock providers require development.
APP_ENV=development

# Supabase
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Server-side only (Edge Functions, scripts). Never ship it in the app.
SUPABASE_SERVICE_ROLE_KEY=

# Later phases
# REVENUECAT_WEBHOOK_SECRET=
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://eu.i.posthog.com
# SENTRY_DSN=
