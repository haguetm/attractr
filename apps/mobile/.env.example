# Copy to apps/mobile/.env (never committed).
# On a physical phone, replace 127.0.0.1 by the LAN IP of the computer running Supabase.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Local anon key: printed by `npx supabase status`. Public by design (RLS protects the data).
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# development | beta | production. Dev tools ("tester en tant que") only with development.
EXPO_PUBLIC_APP_ENV=development
# phone (SMS code, production) | email (code by email, free beta: docs/BETA.md).
EXPO_PUBLIC_AUTH_METHOD=phone
# RevenueCat public SDK keys (Project settings > API keys). Empty = purchases disabled.
# Beta: the Test Store key (test_...) in both, purchases are simulated (docs/BETA.md).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# PostHog EU project API key (Project settings). Empty = no product analytics.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
