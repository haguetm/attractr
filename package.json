{
  "name": "attractr",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "supabase/seed",
    "supabase/lite"
  ],
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "seed:generate": "npm run generate --workspace @attractr/seed",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "functions:test": "cd supabase/functions && npx --yes deno@2 test --allow-env",
    "functions:check": "cd supabase/functions && npx --yes deno@2 check update-location/index.ts delete-account/index.ts dev-impersonate/index.ts",
    "mobile": "npm run start --workspace @attractr/mobile",
    "functions:serve": "supabase functions serve --env-file supabase/functions/.env",
    "functions:deploy": "node scripts/deploy-functions.mjs",
    "db:test:lite": "npm run test:db --workspace @attractr/db-lite --"
  },
  "devDependencies": {
    "supabase": "^2.119.0"
  }
}
