# Copy to supabase/functions/.env (never committed); loaded by `supabase functions serve`.
# Hosted projects set their secrets with `supabase secrets set APP_ENV=production`.
APP_ENV=development

# AI profile analysis (only read when providers.ai = "real"). Set it with `supabase secrets set` on hosted projects.
ANTHROPIC_API_KEY=

# Metrics dashboard (tools/dashboard). 32+ random characters, e.g. `openssl rand -hex 32`.
METRICS_DASHBOARD_TOKEN=
